# homefood-server
PORT=4000

# MongoDB connection string — required.
# Create a free cluster at https://www.mongodb.com/atlas (or run a local mongod)
# and paste your connection string below.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=homefood

JWT_SECRET=replace-with-a-long-random-secret

# Public URL of the web app (used to build password-reset links in dev)
FRONTEND_URL=http://localhost:5173

# In production set to "false" so register / forgot-password never return raw tokens in JSON.
# Default: off in production, on in development.
# EXPOSE_AUTH_TOKENS_IN_API=false

# AI ordering assistant (POST /api/agent/chat). Without this key the endpoint returns 503.
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

NODE_ENV=development

# Contact form email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_TO=your-email@gmail.com
